# --- PostgreSQL Ville (schéma dédié, jamais celui d'une autre application) ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=ivry_admin
POSTGRES_USER=
POSTGRES_PASSWORD=
LOCATIF_SCHEMA=locatif            # doit commencer par "locatif"

# --- API centrale APM (AD, mail) ---
APM_API_URL=https://api.ivry.local
APM_API_KEY=                      # clé X-API-KEY (permissions : ad_auth, ad_read, ad_search, mail_send)

# --- API Hub DSI (sites, directions/services) ---
HUBDSI_API_URL=                   # ex. https://dsihub.ivry.local
HUBDSI_API_KEY=                   # clé dsk_… scope ville
VILLE_ALLOW_SELF_SIGNED_CERTS=false

# --- Application ---
PORT=3320
JWT_SECRET=                       # secret propre à cette application
CORS_ORIGINS=http://localhost:3321
PUBLIC_BASE_URL=http://localhost:3321

# --- Compte administrateur local (en plus de l'AD) ---
LOCAL_ADMIN_ENABLED=true
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin        # à changer en production

# --- Alertes ---
LOCATIF_SCHEDULER_ENABLED=false
LOCATIF_SCHEDULER_HOUR=6
ALERT_MAIL_TO=                    # destinataire par défaut des alertes sans assigné

# --- Stockage documentaire (modifiable dans l'écran GED) ---
STORAGE_FILER_ROOT=               # dossier local ou \\serveur\partage
MAX_UPLOAD_MB=50
SOFFICE_PATH=                     # LibreOffice, pour le PDF des modèles Word personnalisés

# --- Reprise ASTECH (lecture seule) ---
ASTECH_ENV=prod
ORACLE_CLIENT_LIB_DIR=C:/dev/astech-explorer/instantclient/instantclient_21_23
ORACLE_ASTECH_HOST=
ORACLE_ASTECH_PORT=1523
ORACLE_ASTECH_SERVICE=
ORACLE_ASTECH_USER=
ORACLE_ASTECH_PASSWORD=
